msgstr "Obnovit heslo"

#: pages/reset-password/index.vue:6
msgid "Enter your email."
msgstr "Zadejte svůj email"

#: pages/reset-password/index.vue:7
msgid "We will send you email with link."
msgstr "Pošleme vám email s odkazem."

#: pages/reset-password/index.vue:8
msgid "Open the link and set your new password."
msgstr "Otevřete odkaz a nastavte si nové heslo."

#: pages/reset-password/index.vue:14
msgid "Your email"
msgstr "Váš email"

#: pages/reset-password/index.vue:22
msgid "Request reset"
msgstr "Obnovit heslo"

#: pages/reset-password/index.vue:27
msgid "Password reset requested"
msgstr "Zažádal jste o obnovení hesla"

#: pages/reset-password/index.vue:28
msgid "Check your inbox for email with the reset link."
msgstr "Zkontrolujte svůj email."

#: pages/index.vue:50
msgid "No articles or tweets yet"
msgstr "Zatím žádné články nebo tweety"

#: pages/index.vue:52
msgid ""
"Nothing was published for you yet. Check your subscriptions or explore more "
"newspapers and authors."
msgstr ""
"Zatím pro vás nevyšla žádná publikace. Podívejte se na vaše Odběry nebo "
"prozkoumejte další noviny a autory."

#: pages/index.vue:66
msgid "That's it. You read the entire day."
msgstr "Hotovo. Máte přečtený celý den."

#: pages/signup.vue:36
msgid ""
"Kairly is platform which aims to improve environment for journalism. Sign up "
"for beta version."
msgstr ""
"Kairly je platforma, která se snaží vytvořit lepší prostředí pro "
"žurnalistiku. Zaregistrujte se do beta verze."

#: pages/subscription/authors.vue:6
msgid "No authors"
msgstr "Žádní autoři"

#: pages/subscription/authors.vue:7
msgid ""
"You haven't subscribe to any author yet. On Explore page you can find "
"authors you might like."
msgstr ""
"Zatím neodebíráte žádného autora. Projďete si autory, které by se vám mohli "
"zamlouvat."

#: pages/subscription/authors.vue:8
msgid "Explore authors"
msgstr "Objevujte autory"

