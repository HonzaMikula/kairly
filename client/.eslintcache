ount":0},{"filePath":"540","messages":"541","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"542","messages":"543","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/janmikula/www/kairly/client/middleware/i18n.js",[],["544"],"/home/janmikula/www/kairly/client/plugins/vue-uid.js",[],["545"],"/home/janmikula/www/kairly/client/plugins/axios.js",[],["546"],"/home/janmikula/www/kairly/client/store/modals.js",[],["547"],"/home/janmikula/www/kairly/client/store/messages.js",[],["548"],"/home/janmikula/www/kairly/client/pages/_author/_newspaper/settings.vue",[],["549"],"/home/janmikula/www/kairly/client/pages/posts/_postId.vue",[],"/home/janmikula/www/kairly/client/pages/user/transactions.vue",[],["550"],"/home/janmikula/www/kairly/client/pages/user/add-credits.vue",[],"/home/janmikula/www/kairly/client/pages/user/transactions/index.vue",[],["551"],"/home/janmikula/www/kairly/client/pages/signup.vue",[],["552"],"/home/janmikula/www/kairly/client/pages/import.vue",["553"],"/home/janmikula/www/kairly/client/pages/_author/_post.vue",[],"/home/janmikula/www/kairly/client/components/widgets/RecommendButtonPost.vue",[],"/home/janmikula/www/kairly/client/components/posts/PostTweet.vue",[],["554"],"/home/janmikula/www/kairly/client/components/widgets/IssueWidget.vue",[],["555"],"/home/janmikula/www/kairly/client/components/widgets/AuthorPicture.vue",[],"/home/janmikula/www/kairly/client/components/posts/TweetAttachmentVideo.vue",[],["556"],"/home/janmikula/www/kairly/client/components/posts/TweetAttachmentLink.vue",[],"/home/janmikula/www/kairly/client/components/posts/PostRecommendations.vue",[],"/home/janmikula/www/kairly/client/mixins/ErrorHandler.js",[],"/home/janmikula/www/kairly/client/lib/vue-clickaway/index.js",[],["557"],"/home/janmikula/www/kairly/client/components/microsite/Footer.vue",[],"/home/janmikula/www/kairly/client/components/modals/PublishPostModal.vue",[],"/home/janmikula/www/kairly/client/components/editor/EditTweet.vue",[],"/home/janmikula/www/kairly/client/utils/browser.js",[],"/home/janmikula/www/kairly/client/components/modals/AuthorSubscriptionModal.vue",[],"/home/janmikula/www/kairly/client/components/microsite/SignUpForm.vue",["558"],"<template>\n  <div class=\"microsite-signup-form\">\n    <h2>{{ $t('@signupform/heading') }}</h2>\n    <div v-if=\"error\" class=\"error\">{{ error }}</div>\n\n    <div>\n      <label>{{ $t('Username') }}</label>\n      <input v-model=\"username\">\n    </div>\n    <div>\n      <label>{{ $t('Email') }}</label>\n      <input v-model=\"email\" placeholder=\"@\">\n    </div>\n    <div>\n      <label>{{ $t('Password') }}</label>\n      <input v-model=\"password\" type=\"password\">\n      <p>{{ $t('At least 8 characters') }}</p>\n    </div>\n\n    <button @click=\"submit\">{{ $t('Sign Up') }}</button>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'SignUpForm',\n\n  fetch ({ store, redirect }) {\n    if (store.state.auth.loggedIn) {\n      redirect('/')\n    }\n  },\n\n  data () {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: null\n    }\n  },\n\n  methods: {\n    async submit () {\n      const { username, email, password } = this\n\n      try {\n        const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone\n        await this.$axios.post('/signup',\n          { username, email, password },\n          { headers: { 'X-Timezone': timeZone } }\n        )\n        await this.$auth.loginWith('local', {\n          data: { username, password }\n        })\n        this.$ga.event({\n          eventCategory: 'Sign up',\n          eventAction: 'Successful'\n        })\n        this.$ga.set('dimension2', 'new-user')\n        this.$router.push('/')\n      } catch (err) {\n        if (err.response) {\n          this.error = err.response.data.error\n        } else {\n          this.error = err\n        }\n        this.$ga.event({\n          eventCategory: 'Sign up',\n          eventAction: 'Error',\n          eventLabel: this.error\n        })\n      }\n    }\n  }\n}\n</script>\n\n<style lang=\"sass\">\n//- Imports\n@import './styles/components/buttons'\n\n//- SIGN UP FORM -//\n.microsite-signup-form\n  border-radius: 5px\n  padding: $baseline\n\n  background: #fff\n  background: rgba(255,255,255,0.95)\n  border: 1px solid #ddd\n\n  font-family: $ff-sans\n\n  @media (max-width: $mobile)\n    border: 0\n    border-radius: 0\n    border-top: 1px solid #ddd\n    border-bottom: 1px solid #ddd\n\n  //- Heading\n  h2\n    margin-bottom: $baseline / 4\n\n    font-size: $fs-2\n    font-weight: 600\n\n  p\n    margin-bottom: $baseline / 2\n    line-height: 1.42\n\n  //- Label\n  label\n    color: #000\n\n  //- Form Fields\n  input\n    box-sizing: border-box\n    height: $baseline * 1.25\n    padding: 0 $baseline/4\n    width: 100%\n\n    background: #fff\n    border: 1px solid #ddd\n    border-radius: 5px\n\n    font-family: $ff-sans\n    font-size: $fs-0\n\n    &:focus\n      background: #fff\n\n  //- Note\n  p\n    color: #777\n\n    font-size: $fs--1\n    text-align: left\n\n  //- Button\n  button\n    +button(primary, medium)\n    width: 100%\n    max-width: 200px\n    margin: 0 auto\n    display: table\n\n  div\n    margin-bottom: $baseline / 2\n\n  .error\n    color: $c-red\n\n    list-style: disc\n\n    text-align: left\n\n</style>\n","/home/janmikula/www/kairly/client/components/modals/ChangePasswordModal.vue",[],["559"],"/home/janmikula/www/kairly/client/layouts/default.vue",[],"/home/janmikula/www/kairly/client/store/timeline.js",[],"/home/janmikula/www/kairly/client/pages/posts/create/article.vue",[],"/home/janmikula/www/kairly/client/pages/user/settings.vue",[],"/home/janmikula/www/kairly/client/pages/system.vue",[],"/home/janmikula/www/kairly/client/pages/search.vue",[],"/home/janmikula/www/kairly/client/pages/index.vue",[],"/home/janmikula/www/kairly/client/components/widgets/NewspaperWidget.vue",[],"/home/janmi