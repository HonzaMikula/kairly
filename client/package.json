{
  "name": "kairly",
  "version": "1.0.0",
  "description": "New way how we consume and produce news",
  "author": "Jan Mikula <janm@salsitasoft.com>",
  "private": true,
  "scripts": {
    "dev": "API_URL=https://kairly.com/api GA_ID=UA-114180015-1 nuxt",
    "local": "API_URL=http://localhost:8000/api GA_ID=UA-114180015-1 nuxt",
    "dev-spa": "API_URL=https://kairly.com/api GA_ID=UA-114180015-1 nuxt --spa",
    "local-spa": "API_URL=http://localhost:8000/api GA_ID=UA-114180015-1 nuxt --spa",
    "build": "API_URL_BROWSER=https://kairly.com/api API_URL=https://kairly-2648.rostiapp.cz/api/ GA_ID=UA-114180015-2 nuxt build --modern=server",
    "start": "API_URL_BROWSER=https://kairly.com/api API_URL=https://kairly-2648.rostiapp.cz/api/ GA_ID=UA-114180015-2 nuxt start --modern=server",
    "generate": "nuxt generate",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "precommit": "npm run lint",
    "xgettext": "xgettext-template -L vue --from-code=utf-8 -o po/messages.pot $(find components layouts pages mixins -name \"*.vue\" -o -name \"*.js\")",
    "msgmerge": "msgmerge -N -U po/cs.po po/messages.pot && msgmerge -N -U po/en.po po/messages.pot",
    "makemessages": "npm run xgettext && npm run msgmerge",
    "compilemessages_cs": "../scripts/po2json.py po/cs.po -o po/cs.json",
    "compilemessages_en": "../scripts/po2json.py po/en.po -o po/en.json",
    "compilemessages": "npm run compilemessages_cs && npm run compilemessages_en"
  },
  "dependencies": {
    "@nuxtjs/auth": "^4.5.3",
    "@nuxtjs/axios": "^5.4.1",
    "@nuxtjs/google-analytics": "^2.2.0",
    "@nuxtjs/style-resources": "^0.1.2",
    "axios-retry": "^3.1.2",
    "bootstrap-vue": "^2.0.0-rc.14",
    "jwt-decode": "^2.2.0",
    "medium-editor": "^5.23.3",
    "nuxt": "^2.4.5",
    "portal-vue": "^1.5.1",
    "vue-i18n": "^8.9.0",
    "vue-infinite-scroll": "^2.0.2",
    "vue-keep-scroll": "^0.1.1",
    "vue-moment": "^4.0.0",
    "vue-moment-jalaali": "^2.0.0",
    "vue-picture-input": "^2.1.6"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^5.7.2",
    "babel-eslint": "^10.0.1",
    "eslint": "^5.15.1",
    "eslint-loader": "^2.1.2",
    "eslint-plugin-vue": "^5.2.2",
    "gettext-vue": "^0.3.1",
    "node-reset-scss": "^1.0.1",
    "node-sass": "^4.11.0",
    "sass-loader": "^7.1.0",
    "xgettext-template": "^3.4.2"
  }
}
