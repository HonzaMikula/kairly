{
  "name": "kairly",
  "version": "1.0.0",
  "description": "New way how we consume and produce news",
  "author": "Jan Mikula <janm@salsitasoft.com>",
  "private": true,
  "scripts": {
    "dev-prodapi": "API_URL=https://api.kairly.com/api nuxt",
    "dev": "API_URL=http://localhost:8000/api nuxt",
    "dev-spa-prodapi": "API_URL=https://api.kairly.com/api nuxt --spa",
    "dev-spa": "API_URL=http://localhost:8000/api nuxt --spa",
    "build": "API_URL=https://api.kairly.com/api nuxt build --modern=server",
    "start": "API_URL=https://api.kairly.com/api nuxt start --modern=server",
    "generate": "nuxt generate",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "precommit": "npm run lint",
    "xgettext": "xgettext-template -L vue --from-code=utf-8 -o po/messages.pot $(find components layouts pages mixins -name \"*.vue\" -o -name \"*.js\")",
    "msgmerge": "msgmerge -N -U po/cs.po po/messages.pot && msgmerge -N -U po/en.po po/messages.pot",
    "makemessages": "npm run xgettext && npm run msgmerge",
    "compilemessages_cs": "../scripts/po2json.py po/cs.po -o po/cs.json",
    "compilemessages_en": "../scripts/po2json.py po/en.po -o po/en.json",
    "compilemessages": "npm run compilemessages_cs && npm run compilemessages_en"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-balloon-block": "github:farin/ckeditor5-build-kairly#master",
    "@ckeditor/ckeditor5-vue": "^1.0.1",
    "@nuxtjs/auth": "^4.9.1",
    "@nuxtjs/axios": "^5.12.3",
    "@nuxtjs/google-analytics": "^2.4.0",
    "@nuxtjs/redirect-module": "^0.3.1",
    "async-sema": "^3.1.0",
    "bootstrap-vue": "^2.19.0",
    "cheerio": "^1.0.0-rc.3",
    "install": "^0.13.0",
    "jwt-decode": "^3.1.2",
    "nuxt": "^2.14.7",
    "nuxt-clipboard2": "^0.2.1",
    "portal-vue": "^2.1.7",
    "universal-url": "^2.0.0",
    "vue-i18n": "^8.22.2",
    "vue-infinite-scroll": "^2.0.2",
    "vue-moment": "^4.1.0",
    "vue-moment-jalaali": "^2.0.0",
    "vue-picture-input": "^2.1.6",
    "vue-uid": "^0.4.5",
    "vuedraggable": "^2.24.3"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^5.15.1",
    "@nuxtjs/eslint-config": "^5.0.0",
    "@nuxtjs/eslint-module": "^3.0.1",
    "@nuxtjs/style-resources": "^1.0.0",
    "babel-eslint": "^10.0.3",
    "eslint": "^7.14.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-nuxt": "^2.0.0",
    "gettext-vue": "^0.4.1",
    "node-reset-scss": "^1.0.1",
    "node-sass": "^5.0.0",
    "sass-loader": "^10.0.1",
    "xgettext-template": "^3.4.2"
  }
}
